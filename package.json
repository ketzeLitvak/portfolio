{
  "name": "ketze-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run test:lint-rules && npm run test:experiments && npm run format:check && npm run build",
    "test:lint-rules": "node --test eslint-rules/*.test.js",
    "test:experiments": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "faceshape-react": "^0.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.1.0"
  }
}
